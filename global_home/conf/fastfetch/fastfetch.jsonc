{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
      "type": "file",
      "source": "~/.config/fastfetch/my_logo.txt",
      "padding": {
        "right": 4
      }
  },

  "display": {
    "separator": ": "
  },

  "modules": [
    "title",

    {
      "type": "separator",
      "string": "_"
    },
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "locale",
    "break",
    "colors"
  ]
}
