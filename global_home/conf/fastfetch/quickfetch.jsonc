{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/nix_logo.txt",
    "padding": {
      "right": 4
    }
  },

  "display": {
    "separator": ": "
  },

  "modules": [
    "title",

    {
      "type": "separator",
      "string": "_"
    },
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
  ]
}
